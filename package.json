{
  "name": "lossless-recall",
  "version": "0.1.0",
  "description": "Lossless conversation recall for Claude Code — captures every turn to SQLite with full-text search",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "lossless-recall": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "vitest run",
    "capture": "tsx src/capture.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.1",
    "safe-regex2": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
